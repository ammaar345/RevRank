<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.RevRank" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Primary brand color. -->
        <item name="colorPrimary">#00FF41</item>
        <item name="colorOnPrimary">#000000</item>
        <!-- Secondary brand color. -->
        <item name="colorSecondary">#00C032</item>
        <item name="colorOnSecondary">#FFFFFF</item>
        <!-- Background color. -->
        <item name="android:colorBackground">#0A0A0A</item>
        <!-- Status bar color. -->
        <item name="android:statusBarColor">#000000</item>
        <!-- Navigation bar color. -->
        <item name="android:navigationBarColor">#000000</item>
    </style>

    <style name="Theme.TripLaunchTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <!-- Show a launch screen that matches the app's eventual theme. -->
        <item name="android:windowBackground">@drawable/launch_screen</item>
    </style>
</resources>